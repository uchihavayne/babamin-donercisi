extends SceneTree
var game: Node
var checks := 0
var failures: Array[String] = []
func _initialize() -> void: call_deferred("run")
func check(ok: bool, message: String) -> void:
	checks += 1
	if not ok: failures.append(message); push_error(message)
func step(count := 1, fps := 60) -> void:
	for i in count:
		game.stations.refresh()
		game.stations.tick(1.0/fps)
		game.controls.tick(1.0/fps)
		if game.j_G.scene == "play" and not game.suspended: game.game_loop.f_updatePlay(1.0/fps)
		game.effects.f_inEnd()
func button(index: int, down: bool) -> void:
	var e := InputEventJoypadButton.new()
	e.device = 0; e.button_index = index; e.pressed = down
	game._input(e)
func tap(index: int) -> void:
	button(index,true); step(); button(index,false); step()
func select(id: String) -> void: game.stations.select(id)
func act(id: String) -> void: game.stations.press(id,"test"); step(); game.stations.release("test")
func hold(id: String, frames := 60) -> void: game.stations.press(id,"test"); step(frames); game.stations.release("test")
func fresh(up := {}) -> void:
	game.controls.release_all()
	game.j_G.up = up
	game.f_startDay()
	game.j_G.shutT = 0; game.j_G.tut = 99; game.j_G.spawnT = 10000
	game.j_G.timeLeft = 10000
	game.controls.set_mode("controller")
	game.stations.refresh()
func run() -> void:
	game = load("res://scripts/platform_game.gd").new()
	game.storage.path = "res://artifacts/stations/test-save.json"; game.storage.values = {}
	root.add_child(game)
	game.set_process(false); game.j_MUTED = true
	fresh()
	check(game.stations.available(),"station controls enabled by default")
	var stick := InputEventJoypadMotion.new()
	stick.device=0; stick.axis=JOY_AXIS_LEFT_X; stick.axis_value=0.2
	game._input(stick); step(3)
	check(game.stations.selected == "spit","stick deadzone does not change station")
	stick.axis_value=1; game._input(stick); step(); stick.axis_value=0; game._input(stick)
	check(game.stations.selected != "spit","stick snaps to a station instead of free aiming")
	select("board:0"); tap(JOY_BUTTON_A)
	check(game.j_G.boards[0] is Dictionary,"controller opens bread on chosen empty board")
	game.j_G.meat=16; game.j_G.stock.pickle=16; game.j_G.stock.yogurt=16; game.j_G.friesTray=16
	select("meat")
	check(game.stations.primary().id == "meat","real meat tray exposes its direct action")
	for i in 4: tap(JOY_BUTTON_A)
	check(game.j_G.boards[0].meat == 4 and game.j_G.meat == 12,"controller ingredient consumes exact stock")
	for ingredient in ["pickle","yogurt","fries"]:
		select("friesT" if ingredient == "fries" else ingredient)
		for i in 4: tap(JOY_BUTTON_A)
	check(game.j_G.boards[0].pickleN == 4 and game.j_G.boards[0].yogurtN == 4 and game.j_G.boards[0].friesN == 4,"complete recipe uses directions and one action button")
	select("board:0")
	button(JOY_BUTTON_A,true); step(5); button(JOY_BUTTON_A,false)
	check(game.j_G.boards[0].state == "open" and game.j_G.boards[0].roll == 0,"releasing an incomplete roll cancels progress")
	button(JOY_BUTTON_A,true); step(20); button(JOY_BUTTON_A,false)
	check(game.j_G.boards[0].state == "rolled","holding action rolls without dragging")
	button(JOY_BUTTON_A,true); step(20); button(JOY_BUTTON_A,false)
	check(game.j_G.boards[0].state == "rolled","manual paper cannot finish before its duration")
	button(JOY_BUTTON_A,true); step(55); button(JOY_BUTTON_A,false)
	check(game.j_G.boards[0].state == "ready" and game.j_G.boards[0].paper,"manual paper hold packages wrap")
	tap(JOY_BUTTON_A)
	check(game.j_G.hand is Dictionary and game.j_G.boards[0] == null,"ready wrap is picked up once")
	game.customer_system.f_spawnCustomer()
	var customer: Dictionary = game.j_G.customers[0]
	customer.state="wait"; customer.x=customer.tx; customer.items=[{"kind":"wrap"}]; customer.done=[false]
	game.stations.refresh()
	var customer_id: String = "customer:"+game.stations.uid(customer)
	select(customer_id); act("serve")
	check(game.j_G.stat.wraps == 1 and game.j_G.hand == null,"station serving uses actual order validation")
	step(90)
	game.stations.refresh()
	for target in game.stations.targets:
		if target.group == "coin": select(target.id); act("collect"); break
	check(game.j_G.money > 0,"controller can collect real sale money")
	fresh({"board":2.0})
	select("board:2"); act("bread")
	check(game.j_G.boards[2] is Dictionary and game.j_G.boards[0] == null,"explicit board creation never falls back to first empty board")
	game.j_G.meat=10; act("meat")
	select("board:0"); act("bread")
	game.j_G.boards[0].meat=4; act("meat")
	check(game.j_G.boards[2].meat == 1,"full chosen board cannot receive ingredients on another board")
	tap(JOY_BUTTON_RIGHT_SHOULDER)
	check(game.stations.selected == "board:1","bumper cycles within preparation boards")
	fresh()
	select("cut"); act("potato"); step(30)
	check(game.j_G.cut.potato,"potato arrives using original flight timer")
	hold("chop",240)
	check(not game.j_G.cut.potato and game.j_G.cut.raw > 0,"hold chops potatoes through original cutting timer")
	var raw: float = game.j_G.cut.raw
	act("fry")
	check(game.j_G.fryer.state == "fry" and game.j_G.cut.raw < raw,"fryer transfers actual raw stock")
	select("fryer"); act("fry")
	check(game.j_G.friesTray == 0,"cooking cannot be skipped by repeated action")
	step(600); act("fry")
	check(game.j_G.friesTray > 0 and game.j_G.fryer.state == "idle","cooked fries can be collected")
	select("crate"); game.j_G.stock.pickle=0; tap(JOY_BUTTON_A); select("refill:pickle"); tap(JOY_BUTTON_A)
	check(game.j_G.stock.pickle == game.stations.tun("refillPer"),"refill obeys original amount")
	select("spit"); tap(JOY_BUTTON_A)
	check(game.j_G.meat == 3 and not game.controls.quick_cut_active,"station cutting tap stops on release")
	fresh({"board":1.0,"grill":1.0})
	select("board:0"); act("bread"); game.j_G.meat=4; act("meat"); hold("roll",20)
	act("paper")
	check(not game.j_G.boards[0].paper,"ungrilled wrap cannot be papered")
	act("grill_put")
	check(game.j_G.grill.slots.size() == 1 and game.j_G.boards[0] == null,"selected wrap goes to grill")
	game.stations.refresh()
	var slot_id: String = "grill:"+game.stations.uid(game.j_G.grill.slots[0])
	select(slot_id); act("grill_take")
	check(game.j_G.grill.slots.size() == 1,"raw grill slot cannot be taken early")
	step(220); act("grill_take")
	check(game.j_G.grill.slots.is_empty() and game.j_G.boards[0].grilled,"ready selected grill slot returns to board")
	select("board:0"); hold("paper",55)
	check(game.j_G.boards[0].paper,"cooked wrap can be packaged")
	fresh({"drink":1.0,"ayran":1.0,"fbox":1.0,"sweet":1.0})
	select("drink:ayran"); game.j_G.stock.ayran=3; act("pour")
	check(game.j_G.stock.ayran == 2 and game.j_G.cups.ayran.fill < 1,"pour consumes stock and starts actual fill timer")
	act("drink_take")
	check(game.j_G.hand == null,"unfinished drink cannot be picked up")
	step(240); act("drink_take")
	check(game.j_G.hand is Dictionary and game.j_G.hand.kind == "drink","filled drink can be picked up")
	act("return"); select("fbox"); game.j_G.friesTray=5; act("fbox")
	check(game.j_G.friesTray == 3 and game.j_G.fbox.busy > 0,"box action consumes two fries and starts packing timer")
	step(180); act("fbox")
	check(game.j_G.hand is Dictionary and game.j_G.hand.kind == "fbox","prepared box can be picked up")
	fresh()
	select("board:0"); act("bread"); game.j_G.meat=4; act("meat")
	game.stations.press("roll","test"); step(5); game.controls.pause(); step(40)
	check(game.j_G.boards[0].state == "open" and game.stations.holding.is_empty(),"pause cancels active preparation without completing it")
	game.controls.pause()
	game.stations.press("roll","test"); step(5); game.controls.disconnected(0)
	check(game.stations.holding.is_empty() and game.j_G.scene == "pause","controller disconnect cancels hold and pauses")
	game.controls.pause(); game.overlay_open=true; act("meat")
	check(game.j_G.boards[0].meat == 1,"overlay blocks cooking actions")
	game.overlay_open=false
	var finger := InputEventScreenTouch.new()
	finger.index=0; finger.pressed=true; finger.position=Vector2(137,220)
	game._input(finger); step(); finger.pressed=false; game._input(finger); step()
	check(game.stations.selected == "board:0" and game.stations.holding.is_empty() and game.j_G.boards[0].state == "open" and game.j_G.drag == null,"short touch cancels roll without creating a drag")
	fresh({"iskender":1.0,"garnish":1.0,"board":1.0})
	select("board:1"); act("pide")
	check(game.j_G.boards[1] is Dictionary and game.j_G.boards[0] == null,"pide opens on the selected board")
	for i in int(game.j_PIDE_NEED): act("pide_chop")
	check(game.j_G.boards[1].kind == "plate","pide chopping preserves original number of cuts")
	game.j_G.meat=16; game.j_G.stock.yogurt=16; game.j_G.stock.tomato=16; game.j_G.stock.pepper=16
	for id in ["meat","yogurt","tomato","pepper"]:
		for i in 12: act(id)
	act("butter")
	check(game.j_G.boards[1].state == "ready" and game.recipe_system.f_plateFull(game.j_G.boards[1]),"all advanced plate ingredients remain accessible")
	check(game.stations.order_label({"kind":"wrap","sauce":"hot","yok":["pickle"]}).contains("pickle"),"order description includes recipe exclusions")
	fresh()
	var fine := InputEventJoypadMotion.new()
	fine.device=0; fine.axis=JOY_AXIS_TRIGGER_LEFT; fine.axis_value=1
	game._input(fine)
	stick.axis_value=1; game._input(stick)
	var old_x: float=game.j_IN.x
	step(3)
	check(game.j_IN.x > old_x and not game.controls.station_mode(),"held left trigger exposes precision pointer for special world controls")
	button(JOY_BUTTON_A,true); step(); fine.axis_value=0; game._input(fine); button(JOY_BUTTON_A,false); step()
	check(not game.j_IN.down and game.controls.station_mode(),"leaving precision mode cannot strand a drag")
	stick.axis_value=0; game._input(stick)
	game.controls.set_mode("keyboard"); select("board:0")
	var key := InputEventKey.new()
	key.physical_keycode=KEY_ENTER; key.keycode=KEY_ENTER; key.pressed=true; game._input(key); step()
	key.pressed=false; game._input(key)
	check(game.j_G.boards[0] is Dictionary,"keyboard uses the same preparation actions")
	game.j_G.meat=4; act("meat"); game.stations.press("roll","test"); step(5)
	var motion:=InputEventMouseMotion.new(); motion.position=Vector2(game.j_LAY.spit.cx,110); motion.relative=Vector2.ONE
	game._input(motion); step(30)
	check(game.stations.holding.is_empty() and game.j_G.boards[0].state == "open","switching input device cancels preparation hold")
	fresh({"board":2.0,"grill":1.0,"drink":1.0,"ayran":1.0})
	select("board:2"); select("bread"); tap(JOY_BUTTON_A)
	check(game.j_G.boards[2] is Dictionary and game.j_G.boards[0] == null,"actual bread pile respects the active empty board")
	game.j_G.meat=16; select("meat"); tap(JOY_BUTTON_A)
	tap(JOY_BUTTON_LEFT_SHOULDER)
	check(game.j_G.act == 1 and game.stations.selected == "meat","bumper switches preparation board while keeping ingredient selected")
	tap(JOY_BUTTON_A)
	# BIRLESIK (kullanici karari): malzeme secili bos bolmeye degil, ona ihtiyaci olan urune gider
	check(game.j_G.boards[2].meat == 2 and game.j_G.act == 2,"ingredient with an empty active board goes to the wrap that needs it")
	select("board:2"); button(JOY_BUTTON_A,true); step(20); button(JOY_BUTTON_A,false)
	select("grill"); tap(JOY_BUTTON_A)
	check(game.j_G.grill.slots.size() == 1 and game.j_G.boards[2] == null,"actual grill fixture accepts active rolled wrap")
	select("drink:ayran"); game.j_G.stock.ayran=3; tap(JOY_BUTTON_A)
	check(game.j_G.cups.ayran is Dictionary and game.j_G.hand == null,"cup primary action starts filling")
	tap(JOY_BUTTON_A)
	check(game.j_G.hand == null,"same primary button cannot pick up unfinished drink")
	step(240); tap(JOY_BUTTON_A)
	check(game.j_G.hand is Dictionary and game.j_G.hand.kind == "drink","same primary button picks up the filled drink")
	tap(JOY_BUTTON_X)
	check(game.j_G.hand == null,"secondary action returns held drink")
	select("crate"); tap(JOY_BUTTON_A); tap(JOY_BUTTON_DPAD_LEFT)
	check(game.j_G.crate.open and game.stations.target().group == "crate","crate navigation stays on visible refill slots")
	tap(JOY_BUTTON_B)
	check(not game.j_G.crate.open,"back closes stock box without pausing")
	var report := {"checks":checks,"failures":failures,"devices":"synthetic controller, keyboard and touch on macOS"}
	var file := FileAccess.open("res://validation/stations/results.json",FileAccess.WRITE)
	file.store_string(JSON.stringify(report,"\t")); file.close()
	print("STATIONS ",JSON.stringify(report))
	game.free(); await process_frame; quit(0 if failures.is_empty() else 1)
